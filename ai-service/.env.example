ENABLE_TEXT_GGUF=false
ENABLE_VISION=false
ENABLE_OCR=false
ENABLE_WHISPER=false
ENABLE_EMBEDDINGS=false
ENABLE_TRAINING=true
LLAMA_SERVER_PORT=8081
LLAMA_NGL=0
