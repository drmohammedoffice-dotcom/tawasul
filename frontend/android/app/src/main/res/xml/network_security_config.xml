<?xml version="1.0" encoding="utf-8"?>
<!-- Dev/local HTTP API (cleartext). Tighten for production HTTPS backends. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
