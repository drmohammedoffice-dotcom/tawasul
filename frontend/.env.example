VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000/realtime

# Capacitor / Android — set to your PC LAN IPv4 (works for physical phone + usually emulator).
# Emulator-only alternative: 10.0.2.2
# Leave unset for browser-only desktop (localhost).
# Phone on same Wi‑Fi as PC (update IP if yours changed). Emulator-only alternative: 10.0.2.2
VITE_NATIVE_API_HOST=192.168.0.144

# Firebase web push (browser / PWA). Android uses google-services.json instead.
# Cloud Messaging → Web Push certificates → Key pair (public VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
