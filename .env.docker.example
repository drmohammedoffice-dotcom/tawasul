# Compose ports
BACKEND_PORT=3000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres
POSTGRES_DB=secure_messaging
POSTGRES_USER=app
POSTGRES_PASSWORD=app
