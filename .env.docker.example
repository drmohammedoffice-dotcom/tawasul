# Redis
REDIS_URL=redis://redis:6379

# Frontend build-time API endpoints
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000/realtime

# Backend CORS
CLIENT_ORIGIN=http://localhost:5173
