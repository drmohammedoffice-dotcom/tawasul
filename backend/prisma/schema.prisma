  views            StoryView[]
  replies          StoryReply[]
  reactions        StoryReaction[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
  @@index([moderationStatus])
}

enum StoryAudience {
  everyone
  close_friends
  family
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

/// Instagram-style quick reaction on a story (emoji sticker).
model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId, createdAt])
}

/// Text reply / DM-style comment under a story.
model StoryReply {
  id        String   @id @default(cuid())
  storyId   String
  authorId  String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([authorId, createdAt])
}

model Reel {
  id               String        @id @default(cuid())
  authorId         String
  mediaId          String
  caption          String?       @db.VarChar(2200)
  /// Display box: "9:16" | "16:9"
  aspectRatio      String?       @db.VarChar(8)
  thumbnailMediaId String?
  commentsDisabled Boolean       @default(false)
  archivedAt       DateTime?
  clientRequestId  String?
  viewCount        Int           @default(0)
  shareCount       Int           @default(0)
  moderationStatus String        @default("PENDING_REVIEW") @db.VarChar(32)
  contentFingerprint String?     @db.VarChar(64)
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media            MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  likes            ReelLike[]
  comments         ReelComment[]
  hashtags         ReelHashtag[]

  @@unique([authorId, clientRequestId])
  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([moderationStatus, createdAt])
  @@index([contentFingerprint])
}

model ReelLike {
  id        String   @id @default(cuid())
  reelId    String
  userId    String
  createdAt DateTime @default(now())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
}

model ReelComment {
  id               String    @id @default(cuid())
  reelId           String
  authorId         String
  parentId         String?
  body             String    @db.VarChar(1000)
  moderationStatus String        @default("APPROVED") @db.VarChar(32)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  reel             Reel      @relation(fields: [reelId], references: [id], onDelete: Cascade)
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent           ReelComment?  @relation("ReelCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies          ReelComment[] @relation("ReelCommentReplies")

  @@index([reelId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([moderationStatus])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  entityType  String?
  entityId    String?
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// FCM registration token for one install (Android, web, or iOS).
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(4096)
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Push gates shared across devices. In-app sound and badge options stay on the device.
model NotificationPreference {
  userId            String   @id
  privateChats      Boolean  @default(true)
  groups            Boolean  @default(true)
  channels          Boolean  @default(true)
  stories           Boolean  @default(true)
  reactions         Boolean  @default(true)
  newContacts       Boolean  @default(true)
  social            Boolean  @default(true)
  calls             Boolean  @default(true)
  inAppPreview      Boolean  @default(true)
  namesOnLockScreen Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  details      String?
  /// open | triaged | resolved | dismissed | abusive
