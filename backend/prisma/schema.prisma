generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String?        @unique
  username     String         @unique
  role         UserRole       @default(free)
  passwordHash String
  displayName  String?
  bio          String?        @db.VarChar(500)
  /// Last successful username change (30-day cooldown).
  usernameChangedAt DateTime?
  avatarUrl    String?
  coverUrl     String?
  isPrivate    Boolean        @default(false)
  /// Smoke/integration fixture accounts — hidden from public Explore/Search/Reels. Never delete blindly.
  isAutomatedTest Boolean     @default(false)
  accountType  AccountType    @default(personal)
  phoneE164    String?        @unique
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  countryCode  String?        @db.VarChar(2)
  isVerified   Boolean        @default(false)
  verifiedAt   DateTime?
  twoFactorEmailEnabled Boolean @default(false)
  /// AES-GCM sealed TOTP seed (never plaintext). Null when TOTP disabled.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// bcrypt hashes of one-time recovery codes (cleared as used).
  totpRecoveryHashes String[] @default([])
  passwordSetAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  sentMessages Message[]      @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  reactions    MessageReaction[]
  mediaAssets  MediaAsset[]
  ownedGroups Group[] @relation("GroupOwner")
  groupMemberships GroupMember[]
  channelSubscriptions Subscription[]
  createdChannels Channel[] @relation("ChannelCreator")
  groupMessages GroupMessage[]
  channelMessages ChannelMessage[]
  userSubscriptions UserSubscription[]
  analyticsEvents BetaAnalyticsEvent[]
  feedbackEntries FeedbackEntry[]
  wallet Wallet?
  walletTransactionsFrom WalletTransaction[] @relation("WalletTransactionFromUser")
  walletTransactionsTo WalletTransaction[] @relation("WalletTransactionToUser")
  dailyRewardProgress DailyRewardProgress?
  dailyRewardClaims DailyRewardClaim[]
  taskProgress UserTaskProgress[]
  taskRewardClaims TaskRewardClaim[]
  sentInvites TaskInviteAttribution[] @relation("TaskInviteSent")
  receivedInvites TaskInviteAttribution[] @relation("TaskInviteReceived")
  sentGifts GiftTransfer[] @relation("GiftSender")
  receivedGifts GiftTransfer[] @relation("GiftReceiver")
  miniGamePlays MiniGamePlay[]
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")
  posts Post[]
  postLikes PostLike[]
  postViews PostView[]
  comments Comment[]
  bookmarks Bookmark[]
  stories Story[]
  storyViews StoryView[]
  storyReplies StoryReply[]
  storyReactions StoryReaction[]
  reels Reel[]
  reelLikes ReelLike[]
  reelComments ReelComment[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActor Notification[] @relation("NotificationActor")
  pushDevices PushDevice[]
  notificationPreference NotificationPreference?
  blocksInitiated UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")
  reportsFiled Report[] @relation("Reporter")
  businessProfile BusinessProfile?
  verificationRequests VerificationRequest[]
  storyHighlights StoryHighlight[]
  closeFriendsOwned CloseFriend[] @relation("CloseFriendOwner")
  closeFriendsOf CloseFriend[] @relation("CloseFriendMember")
  interests UserInterest[]
  phoneOtpChallenges PhoneOtpChallenge[]
  emailOtpChallenges EmailOtpChallenge[]
  reviewedVerifications VerificationRequest[] @relation("VerificationReviewer")
  spacePins SpacePin[]
  chatMutes ChatMute[]
  groupMessageReads GroupMessageRead[]
  channelMessageReads ChannelMessageRead[]
  focusProfile FocusProfile?
  callsCreated CallSession[] @relation("CallCreator")
  callParticipations CallParticipant[]
  contentSignals ContentSignal[]
  catalogProducts CatalogProduct[]
  storeOrdersSold StoreOrder[] @relation("StoreSeller")
  storeOrdersBought StoreOrder[] @relation("StoreBuyer")
  recommendationPreference RecommendationPreference?
  interestWeights UserInterestWeight[]
  recommendationEvents RecommendationEvent[]
  recommendationMutes RecommendationMute[]
  recommendationConfigs RecommendationConfig[] @relation("RecommendationConfigAuthor")
  recommendationAudits RecommendationConfigAudit[] @relation("RecommendationAuditActor")
}

/// Focus-mode identity — independent from social (Browse) profile fields on User.
model FocusProfile {
  userId      String   @id
  displayName String?
  bio         String?  @db.VarChar(150)
  avatarUrl   String?
  /// When true, others won't see Browse social card (followers/posts/follow/view profile) in chats.
  hideBrowseProfile Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  free
  premium
  /// Can review moderation cases and appeals; cannot change policy or ban permanently.
  moderator
  admin
}

enum AccountType {
  personal
  business
}

/// Isolates Browse (social) vs Focus (messaging) data for the same account.
enum AppSpace {
  browse
  focus
}

enum BillingPlan {
  premium_monthly
  premium_yearly
}

enum BillingStatus {
  active
  canceled
  incomplete
  past_due
  trialing
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenId    String   @unique
  sessionId  String
  userId     String
  tokenHash  String
  deviceId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([tokenHash])
}

enum MessageStatus {
  sent
  delivered
  read
}

model Message {
  id               String        @id @default(cuid())
  senderId         String
  receiverId       String
  encryptedContent String
  /// browse = social DMs; focus = Focus Mode DMs (isolated inboxes).
  appSpace         AppSpace      @default(browse)
  timestamp        DateTime      @default(now())
  status           MessageStatus @default(sent)
  sentAt           DateTime      @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
  editedAt         DateTime?
  deletedAt        DateTime?
  isDeleted        Boolean       @default(false)
  replyToMessageId String?
  forwardFromId    String?
  sender           User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  replyToMessage   Message?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]     @relation("MessageReplies")
  forwardFrom      Message?      @relation("MessageForwards", fields: [forwardFromId], references: [id], onDelete: SetNull)
  forwardedCopies  Message[]     @relation("MessageForwards")
  reactions        MessageReaction[]
  mediaAttachments MessageMedia[]

  @@index([senderId, receiverId, timestamp])
  @@index([receiverId, status])
  @@index([replyToMessageId])
  @@index([forwardFromId])
  @@index([appSpace, senderId, receiverId, timestamp])
  @@index([appSpace, receiverId, status])
}

enum MediaProcessingStatus {
  pending
  uploaded
  processing
  ready
  failed
  deleted
}

model MediaAsset {
  id                   String                @id @default(cuid())
  uploaderId           String
  storageProvider      String
  /// Physical object key in storage. Shared across deduped owner rows (not unique).
  storageKey           String
  bucket               String?
  originalFileName     String
  mimeType             String
  mediaType            String                @default("file")
  purpose              String                @default("general")
  sizeBytes            Int
  encryptedFileKey     String
  /// S3/R2 ETag after complete (optional).
  checksum             String?
  /// Client SHA-256 hex of file bytes (deduplication / instant upload).
  contentHash          String?               @db.VarChar(64)
  width                Int?
  height               Int?
  durationSeconds      Float?
  thumbnailKey         String?
  streamUid            String?
  processingStatus     MediaProcessingStatus @default(pending)
  visibility           String                @default("private")
  uploadCompletedAt    DateTime?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  uploader             User                  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  messageAttachments   MessageMedia[]
  postMedia            PostMedia[]
  storyMedia           Story[]
  reelMedia            Reel[]

  @@index([uploaderId])
  @@index([createdAt])
  @@index([processingStatus])
  @@index([streamUid])
  @@index([purpose])
  @@index([storageKey])
  @@index([contentHash])
}

model MessageMedia {
  id        String     @id @default(cuid())
  messageId String
  mediaId   String
  createdAt DateTime   @default(now())
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([messageId, mediaId])
  @@index([messageId])
  @@index([mediaId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

enum GroupRole {
  owner
  admin
  member
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.VarChar(500)
  avatarUrl   String?
  ownerId     String
  /// public | private
  visibility  String        @default("private")
  /// visible | hidden — whether new members see chat history
  historyVisibility String  @default("visible")
  inviteSlug  String?       @unique
  appSpace    AppSpace      @default(browse)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]

  @@index([ownerId])
  @@index([appSpace])
  @@map("group")
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(member)
  createdAt DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model GroupMessage {
  id               String   @id @default(cuid())
  groupId          String
  senderId         String
  encryptedContent String
  timestamp        DateTime @default(now())
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender           User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, timestamp])
  @@index([senderId])
  @@map("group_messages")
}

model Channel {
  id               String         @id @default(cuid())
  name             String
  description      String?        @db.VarChar(500)
  avatarUrl        String?
  createdById      String
  /// public | private
  visibility       String         @default("public")
  inviteSlug       String?        @unique
  pinnedMessageId  String?
  appSpace         AppSpace       @default(browse)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        User           @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
  messages         ChannelMessage[]

  @@index([createdById])
  @@index([appSpace])
  @@map("channels")
}

model Subscription {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  role       GroupRole @default(member) // owner/admin/member for posting permissions
  createdAt  DateTime  @default(now())
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
  @@map("subscriptions")
}

model ChannelMessage {
  id               String   @id @default(cuid())
  channelId        String
  senderId         String
  encryptedContent String
  viewCount        Int      @default(0)
  editedAt         DateTime?
  timestamp        DateTime @default(now())
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender           User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, timestamp])
  @@index([senderId])
  @@map("channel_messages")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorIp      String
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([actorIp, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model UserSubscription {
  id                     String        @id @default(cuid())
  userId                 String
  plan                   BillingPlan
  status                 BillingStatus @default(incomplete)
  provider               String
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("user_subscriptions")
}

enum FeedbackStatus {
  open
  reviewed
  resolved
}

model BetaAnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  eventName String
  path      String
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@map("beta_analytics_events")
}

model FeedbackEntry {
  id        String         @id @default(cuid())
  userId    String?
  email     String?
  category  String
  message   String
  rating    Int?
  status    FeedbackStatus @default(open)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback_entries")
}

enum WalletTransactionType {
  earn
  spend
  transfer
}

enum WalletTransactionStatus {
  completed
  failed
}

enum WalletCurrency {
  coins
  gems
}

enum MiniGameType {
  spin_wheel
  quiz
  scratch_card
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // coins balance
  gemsBalance Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([updatedAt])
  @@map("wallet")
}

model WalletTransaction {
  id         String                  @id @default(cuid())
  walletId    String
  type       WalletTransactionType
  currency   WalletCurrency          @default(coins)
  amount     Int
  status     WalletTransactionStatus @default(completed)
  timestamp  DateTime                @default(now())
  requestId  String?
  reference  String?
  metadata   Json?
  fromUserId String?
  toUserId   String?
  wallet     Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  fromUser   User?                   @relation("WalletTransactionFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser     User?                   @relation("WalletTransactionToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([walletId, timestamp])
  @@index([type, timestamp])
  @@index([fromUserId, timestamp])
  @@index([toUserId, timestamp])
  @@index([currency, timestamp])
  @@index([status, timestamp])
  @@unique([walletId, requestId])
  @@map("wallet_transactions")
}

model MiniGamePlay {
  id          String       @id @default(cuid())
  userId      String
  gameType    MiniGameType
  costCoins   Int
  rewardCoins Int
  playedAt    DateTime     @default(now())
  requestId   String?
  metadata    Json?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType, playedAt])
  @@index([playedAt])
  @@unique([userId, requestId])
  @@map("mini_game_plays")
}

model DailyRewardProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastClaimDate DateTime?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastClaimDate])
  @@map("daily_reward_progress")
}

model DailyRewardClaim {
  id          String   @id @default(cuid())
  userId      String
  claimDate   DateTime
  streakAfter Int
  rewardCoins Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimDate])
  @@index([userId, createdAt])
  @@map("daily_reward_claims")
}

model UserTaskProgress {
  id              String   @id @default(cuid())
  userId          String
  taskKey         String
  progress        Int      @default(0)
  target          Int
  completedAt     DateTime?
  rewardClaimedAt DateTime?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([taskKey, updatedAt])
  @@map("user_task_progress")
}

model TaskRewardClaim {
  id          String   @id @default(cuid())
  userId      String
  taskKey     String
  rewardCoins Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([taskKey, createdAt])
  @@map("task_reward_claims")
}

model TaskInviteAttribution {
  id            String   @id @default(cuid())
  inviterUserId String
  invitedUserId String
  createdAt     DateTime @default(now())
  inviter       User     @relation("TaskInviteSent", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invited       User     @relation("TaskInviteReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([inviterUserId, invitedUserId])
  @@unique([invitedUserId])
  @@index([inviterUserId, createdAt])
  @@map("task_invite_attributions")
}

enum GiftTransferKind {
  coins
  gift
}

enum GiftTransferStatus {
  completed
  failed
}

model GiftTransfer {
  id           String             @id @default(cuid())
  senderId     String
  receiverId   String
  kind         GiftTransferKind
  giftKey      String?
  quantity     Int                @default(1)
  amountCoins  Int
  animationKey String?
  note         String?
  status       GiftTransferStatus @default(completed)
  createdAt    DateTime           @default(now())
  sender       User               @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User               @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([kind, createdAt])
  @@map("gift_transfers")
}

enum FollowStatus {
  pending
  accepted
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(accepted)
  createdAt   DateTime     @default(now())
  follower    User         @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
}

model Post {
  id               String        @id @default(cuid())
  authorId         String
  caption          String?       @db.VarChar(2200)
  /// Display box: "1:1" | "3:4"
  aspectRatio      String?       @db.VarChar(8)
  commentsDisabled Boolean       @default(false)
  viewCount        Int           @default(0)
  shareCount       Int           @default(0)
  archivedAt       DateTime?
  clientRequestId  String?
  /// PENDING_REVIEW | APPROVED | FLAGGED | RESTRICTED | HIDDEN | APPEAL_PENDING | RESTORED | REMOVED | PERMANENTLY_DELETED
  moderationStatus String        @default("PENDING_REVIEW") @db.VarChar(32)
  contentFingerprint String?     @db.VarChar(64)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media            PostMedia[]
  likes            PostLike[]
  comments         Comment[]
  bookmarks        Bookmark[]
  hashtags         PostHashtag[]
  views            PostView[]
  catalogProduct   CatalogProduct?

  @@unique([authorId, clientRequestId])
  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([moderationStatus, createdAt])
  @@index([contentFingerprint])
}

/// Business catalog item linked to a post (price + orderability).
model CatalogProduct {
  id             String   @id @default(cuid())
  sellerId       String
  postId         String   @unique
  title          String?  @db.VarChar(200)
  priceIqd       Int
  /// null = use BusinessProfile.defaultDeliveryFeeIqd
  deliveryFeeIqd Int?
  currency       String   @default("IQD") @db.VarChar(8)
  active         Boolean  @default(true)
  inStock        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  seller         User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  orderItems     StoreOrderItem[]

  @@index([sellerId, active, sortOrder])
}

model StoreOrder {
  id           String   @id @default(cuid())
  sellerId     String
  buyerId      String?
  customerName String  @db.VarChar(120)
  phoneE164    String  @db.VarChar(20)
  countryCode  String  @default("IQ") @db.VarChar(2)
  governorate  String  @db.VarChar(80)
  area         String  @db.VarChar(120)
  landmark     String? @db.VarChar(200)
  status       String  @default("placed") @db.VarChar(32)
  totalIqd     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  seller       User     @relation("StoreSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        User?    @relation("StoreBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  items        StoreOrderItem[]

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
}

model StoreOrderItem {
  id         String         @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int            @default(1)
  unitPriceIqd Int
  order      StoreOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model PostView {
  id       String   @id @default(cuid())
  postId   String
  viewerId String
  viewedAt DateTime @default(now())
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId])
  @@index([viewerId, viewedAt])
}

model PostMedia {
  id        String     @id @default(cuid())
  postId    String
  mediaId   String
  sortOrder Int        @default(0)
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id               String    @id @default(cuid())
  postId           String
  authorId         String
  parentId         String?
  body             String    @db.VarChar(1000)
  moderationStatus String        @default("APPROVED") @db.VarChar(32)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  post             Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent           Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies          Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([moderationStatus])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Story {
  id               String         @id @default(cuid())
  authorId         String
  mediaId          String
  /// everyone | close_friends | family
  audience         StoryAudience  @default(everyone)
  commentsDisabled Boolean        @default(false)
  moderationStatus String        @default("PENDING_REVIEW") @db.VarChar(32)
  contentFingerprint String?      @db.VarChar(64)
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  deletedAt        DateTime?
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
