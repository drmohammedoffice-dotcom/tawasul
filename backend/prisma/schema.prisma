model BusinessProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  businessName           String
  categoryKey            String
  subcategoryKey         String?
  description            String?  @db.VarChar(1000)
  websiteUrl             String?
  externalLinks          Json?
  contactPhone           String?
  addressText            String?
  latitude               Float?
  longitude              Float?
  mapsPlaceId            String?
  /// Default delivery fee (IQD) applied when a product has no per-item fee.
  defaultDeliveryFeeIqd  Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryKey])
}

enum VerificationStatus {
  not_submitted
  pending_review
  more_info_required
  approved
  rejected
}

enum VerificationTrack {
  licensed_business
  individual_seller
}

model VerificationRequest {
  id                 String             @id @default(cuid())
  userId             String
  track              VerificationTrack
  status             VerificationStatus @default(pending_review)
  businessName       String?
  registrationNumber String?
  categoryKey        String?
  applicantName      String?
  notes              String?
  adminNote          String?
  /// SHA-256 of normalized registration number (dedupe licensed track)
  registrationHash   String?
  /// SHA-256 of national ID digits (dedupe individual track) — never store raw ID
  identityHash       String?
  submittedAt        DateTime           @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents          VerificationDocument[]

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([registrationHash])
  @@index([identityHash])
}

model VerificationDocument {
  id          String              @id @default(cuid())
  requestId   String
  /// license | national_id | residency | selfie | other
  docType     String
  mediaId     String
  /// SHA-256 of file bytes for reuse detection (not the document content itself)
  contentHash String
  createdAt   DateTime            @default(now())
  request     VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([contentHash])
  @@index([requestId])
}

model StoryHighlight {
  id           String               @id @default(cuid())
  userId       String
  title        String               @db.VarChar(40)
  coverMediaId String?
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        StoryHighlightItem[]

  @@index([userId, sortOrder])
}

model StoryHighlightItem {
  id          String         @id @default(cuid())
  highlightId String
  /// Snapshot of story media so highlight survives story expiry
  mediaId     String
  storyId     String?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  highlight   StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@unique([highlightId, mediaId])
  @@index([highlightId, sortOrder])
}

model CloseFriend {
  id        String   @id @default(cuid())
  ownerId   String
  friendId  String
  createdAt DateTime @default(now())
  owner     User     @relation("CloseFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend    User     @relation("CloseFriendMember", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([friendId])
}

model UserInterest {
  id          String   @id @default(cuid())
  userId      String
  interestKey String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interestKey])
  @@index([interestKey])
}

model PhoneOtpChallenge {
  id          String   @id @default(cuid())
  phoneE164   String
  /// register | login | link | sensitive
  purpose     String
  codeHash    String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  channel     String   @default("sms")
  userId      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneE164, purpose, createdAt])
  @@index([expiresAt])
}

model EmailOtpChallenge {
  id          String   @id @default(cuid())
  email       String
  purpose     String
  codeHash    String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  userId      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

/// User-scoped pin for dm/group/channel rows in Focus inbox.
model SpacePin {
  id        String   @id @default(cuid())
  userId    String
  spaceType String   /// dm | group | channel
  spaceId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceType, spaceId])
  @@index([userId, sortOrder])
}

model ChatMute {
  id         String   @id @default(cuid())
  userId     String
  targetType String   /// dm | group | channel
  targetId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model GroupMessageRead {
  id                String   @id @default(cuid())
  groupId           String
  userId            String
  lastReadAt        DateTime @default(now())
  lastReadMessageId String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model ChannelMessageRead {
  id                String   @id @default(cuid())
  channelId         String
  userId            String
  lastReadAt        DateTime @default(now())
  lastReadMessageId String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

enum CallKind {
  audio
  video
}

enum CallScope {
  dm
  group
  channel
}

enum CallStatus {
  ringing
  connecting
  connected
  ended
  failed
  rejected
}

model CallSession {
  id          String            @id @default(cuid())
  kind        CallKind
  scope       CallScope
  status      CallStatus        @default(ringing)
  createdById String
  peerUserId  String?
  groupId     String?
  channelId   String?
  createdAt   DateTime          @default(now())
  connectedAt DateTime?
  endedAt     DateTime?
  endReason   String?
  createdBy   User              @relation("CallCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([createdById, status])
  @@index([peerUserId, status])
  @@index([groupId, status])
  @@index([channelId, status])
  @@index([createdAt])
}

model CallParticipant {
  id         String      @id @default(cuid())
  callId     String
  userId     String
  role       String      @default("callee") /// caller | callee | member
  joinedAt   DateTime?
  leftAt     DateTime?
  muted      Boolean     @default(false)
  videoOff   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  call       CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
}

model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique @db.VarChar(64)
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
  reels     ReelHashtag[]

  @@index([tag])
}

model PostHashtag {
  id        String  @id @default(cuid())
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model ReelHashtag {
  id        String  @id @default(cuid())
  reelId    String
  hashtagId String
  reel      Reel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([reelId, hashtagId])
  @@index([hashtagId])
}

/// Preference signals for future ranking — not a full recommender by themselves.
model ContentSignal {
  id         String   @id @default(cuid())
  userId     String
  /// post | reel
  targetType String
  targetId   String
  /// more_like_this | not_interested
  signal     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, signal])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

/// Personalized vs chronological home. Declared topics stay on UserInterest.
model RecommendationPreference {
  userId    String    @id
  /// personalized | following_chronological
  feedMode  String    @default("personalized")
  /// When false, inferred interests are not used and home stays chronological.
  personalizationEnabled Boolean @default(true)
  clearedAt DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Behavioral topic, hashtag, and author weights. Decayed on read. Not traits.
model UserInterestWeight {
  id        String   @id @default(cuid())
  userId    String
  /// topic | hashtag | author
  kind      String
  key       String   @db.VarChar(64)
  weight    Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind])
}

/// Idempotent recommendation events. No message bodies and no raw search text.
model RecommendationEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @db.VarChar(80)
  userId      String
  eventType   String   @db.VarChar(40)
  contentType String?  @db.VarChar(16)
  contentId   String?
  surface     String?  @db.VarChar(24)
  /// Clamped dwell milliseconds or progress 0–100. Never an unverified client duration used raw.
  value       Int?
  /// Normalized search token only (no phone, email, or free text).
  topicKey    String?  @db.VarChar(32)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, contentId, createdAt])
  @@index([contentType, contentId, eventType, createdAt])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

model RecommendationMute {
  id         String   @id @default(cuid())
  userId     String
  /// post | reel | story | author | hashtag
  targetType String
  targetId   String
  /// hide | not_interested | mute
  reason     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
}

/// Versioned ranking settings. Baseline constants ship in code; admins publish a new version.
model RecommendationConfig {
  id          String   @id @default(cuid())
  version     String   @unique @db.VarChar(64)
  active      Boolean  @default(false)
  weights     Json
  note        String?  @db.VarChar(500)
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("RecommendationConfigAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, createdAt])
}

model RecommendationConfigAudit {
  id        String   @id @default(cuid())
  version   String   @db.VarChar(64)
  actorId   String
  action    String   @db.VarChar(32)
  createdAt DateTime @default(now())
  actor     User     @relation("RecommendationAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Anonymous daily totals. No user id. Raw events are pruned after the retention window.
model RecommendationDailyStat {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  eventType String   @db.VarChar(40)
  outcome   String   @db.VarChar(16)
  reason    String   @default("") @db.VarChar(48)
  count     Int      @default(0)

  @@unique([day, eventType, outcome, reason])
  @@index([day])
}

/// Content understanding for a public post or reel (text + optional OCR/transcript).
/// Private messages are never analyzed. Not a trained end-to-end vision model.
model ContentUnderstanding {
  id            String   @id @default(cuid())
  contentType   String   @db.VarChar(16)
  contentId     String
  contentHash   String   @db.VarChar(64)
  modelVersion  String   @db.VarChar(64)
  language      String   @db.VarChar(8)
  topics        Json
  keywords      Json
  quality       String   @default("ok") @db.VarChar(8)
  status        String   @db.VarChar(16)
  confidence    Float    @default(0)
  error         String?  @db.VarChar(200)
  /// Exact OCR string from EasyOCR (may be visual Arabic order).
  ocrRaw        String?  @db.Text
  /// Logical OCR text after Unicode bidi recovery (search / NLP).
  ocrLogical    String?  @db.Text
  /// Display-oriented OCR (UBA get_display of logical).
  ocrDisplay    String?  @db.Text
  /// Normalized OCR text for lexical search.
  ocrSearch     String?  @db.Text
  transcript    String?  @db.Text
  enrichment    Json?
  mediaAnalysis Json?
  analysisKinds Json?
  remoteJobIds  Json?
  analyzedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([contentType, contentId])
  @@index([status, modelVersion])
}

/// Background analysis work. Publish inserts a row and returns immediately.
model ContentAnalysisJob {
  id          String   @id @default(cuid())
  contentType String   @db.VarChar(16)
  contentId   String
  contentHash String   @db.VarChar(64)
  status      String   @default("pending") @db.VarChar(16)
  attempts    Int      @default(0)
  lastError   String?  @db.VarChar(200)
  runAfter    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contentType, contentId, contentHash])
  @@index([status, runAfter])
}

/// BGE-M3 embedding for public post/reel content. Used by semantic search (shadow first).
model ContentEmbedding {
  id           String   @id @default(cuid())
  contentType  String   @db.VarChar(16)
  contentId    String
  contentHash  String   @db.VarChar(64)
  modelId      String   @default("bge-m3") @db.VarChar(32)
  dim          Int      @default(1024)
  /// Float32 vector as JSON array (local scale; pgvector optional later).
  vector       Json
  status       String   @default("ready") @db.VarChar(16)
  sourceText   String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contentType, contentId, modelId])
  @@index([status, modelId])
  @@index([contentType, updatedAt])
}

/// Runtime switches. conversationSignals cannot be enabled.
model RecommendationFeature {
  key       String   @id @db.VarChar(40)
  enabled   Boolean  @default(false)
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Content Safety & Moderation (Phase 38) ─────────────────────────────

/// Numbered policy documents. Active version drives automated decisions.
model ModerationPolicy {
  id          String                    @id @default(cuid())
  key         String                    @unique @db.VarChar(40)
  title       String                    @db.VarChar(120)
  description String?                   @db.Text
  activeVersionId String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  versions    ModerationPolicyVersion[]
}

model ModerationPolicyVersion {
  id         String   @id @default(cuid())
  policyId   String
  version    String   @db.VarChar(32)
  /// JSON categories: { key, enabled, severity, autoAction, humanReview, confidenceThreshold, terms[] }
  categories Json
  changelog  String?  @db.VarChar(500)
  createdById String?
  createdAt  DateTime @default(now())
  policy     ModerationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([createdAt])
}

/// One case per content item under review / action.
model ModerationCase {
  id              String   @id @default(cuid())
  contentType     String   @db.VarChar(16)
  contentId       String
  authorId        String
  /// PENDING_REVIEW | APPROVED | FLAGGED | RESTRICTED | HIDDEN | APPEAL_PENDING | RESTORED | REMOVED | PERMANENTLY_DELETED
  status          String   @default("PENDING_REVIEW") @db.VarChar(32)
  priority        Int      @default(50)
  policyVersionId String?
  policyVersion   String?  @db.VarChar(32)
  contentHash     String   @db.VarChar(64)
  fingerprint     String?  @db.VarChar(64)
  topCategory     String?  @db.VarChar(40)
  topConfidence   Float    @default(0)
  needsHuman      Boolean  @default(false)
  critical        Boolean  @default(false)
  /// Immediate isolation for extreme harm (csam / imminent violence / NCII+threat).
  emergency       Boolean  @default(false)
  riskScore       Float    @default(0)
  assignedReviewerId String?
  summary         String?  @db.VarChar(500)
  /// Internal staff notes — never shown to end users.
  internalNotes   String?  @db.Text
  lastDecisionId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  findings  ModerationFinding[]
  decisions ModerationDecision[]
  appeals   ModerationAppeal[]
  jobs      ModerationJob[]

  @@unique([contentType, contentId, contentHash])
  @@index([status, priority, updatedAt])
  @@index([authorId, createdAt])
  @@index([needsHuman, status])
  @@index([critical, status])
  @@index([emergency, status])
  @@index([riskScore])
  @@index([fingerprint])
  @@index([assignedReviewerId, status])
}

model ModerationFinding {
  id         String   @id @default(cuid())
  caseId     String
  /// text | image | video | audio | ocr | hashtag | report | fingerprint | rule
  source     String   @db.VarChar(24)
  category   String   @db.VarChar(40)
  confidence Float
  severity   Int      @default(50)
  /// Indicators only — never full private message bodies.
  evidence   Json?
  modelId    String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  case       ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, category])
  @@index([category, confidence])
}

model ModerationDecision {
  id              String   @id @default(cuid())
  caseId          String
  /// auto | human | appeal
  actorType       String   @db.VarChar(16)
  actorId         String?
  /// approve | flag | restrict | hide | remove | restore | permanent_delete | dismiss
  action          String   @db.VarChar(32)
  resultingStatus String   @db.VarChar(32)
  category        String?  @db.VarChar(40)
  confidence      Float    @default(0)
  reasonCode      String   @db.VarChar(64)
  /// User-facing reason (no model internals).
  userReason      String?  @db.VarChar(300)
  policyVersion   String?  @db.VarChar(32)
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  case            ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model ModerationAppeal {
  id              String    @id @default(cuid())
  caseId          String
  appellantId     String
  /// OPEN | UNDER_REVIEW | APPROVED | REJECTED | CLOSED
  status          String    @default("OPEN") @db.VarChar(24)
  statement       String    @db.VarChar(2000)
  decisionId      String?
  reviewerId      String?
  previousActorId String?
  resolutionNote  String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
  case            ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([appellantId, createdAt])
  @@index([caseId, status])
}

model UserViolation {
  id           String   @id @default(cuid())
  userId       String
  caseId       String?
  category     String   @db.VarChar(40)
  severity     Int
  /// warning | content_action | post_ban | feature_ban | suspend | disable
  penalty      String   @db.VarChar(32)
  policyVersion String? @db.VarChar(32)
  notes        String?  @db.VarChar(300)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  createdById  String?

  @@index([userId, createdAt])
  @@index([penalty, expiresAt])
}

model ModerationAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(32)
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ModerationJob {
  id          String   @id @default(cuid())
  caseId      String?
  contentType String   @db.VarChar(16)
  contentId   String
  contentHash String   @db.VarChar(64)
  /// pending | running | done | failed
  status      String   @default("pending") @db.VarChar(16)
  attempts    Int      @default(0)
  priority    Int      @default(50)
  lastError   String?  @db.VarChar(200)
  runAfter    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([contentType, contentId, contentHash])
  @@index([status, priority, runAfter])
}

/// Account-level publish / feature restrictions from moderation penalties.
model UserModerationState {
  userId           String    @id
  /// none | warned | restricted | suspended | disabled
  state            String    @default("none") @db.VarChar(24)
  canPublish       Boolean   @default(true)
  canComment       Boolean   @default(true)
  publishBlockedUntil DateTime?
  reasonCode       String?   @db.VarChar(64)
  /// Rolling risk 0–100 from confirmed violations (decays via expiresAt on UserViolation).
  riskScore        Float     @default(0)
  updatedAt        DateTime  @updatedAt
  updatedById      String?
}

/// Blocked / known media fingerprints (exact + perceptual). Not a face gallery.
model ModerationFingerprint {
  id          String   @id @default(cuid())
  /// sha256 | ahash | vframe
  kind        String   @db.VarChar(16)
  value       String   @db.VarChar(128)
  contentType String?  @db.VarChar(16)
  contentId   String?
  caseId      String?
  blocked     Boolean  @default(false)
  /// Match confidence threshold that triggered block (1.0 for sha256).
  confidence  Float    @default(1)
  createdAt   DateTime @default(now())

  @@unique([kind, value])
  @@index([blocked, kind])
  @@index([contentType, contentId])
  @@index([caseId])
}

/// Shadow-mode predictions — never mutate production content status.
model ModerationShadowResult {
  id            String   @id @default(cuid())
  contentType   String   @db.VarChar(16)
  contentId     String
  contentHash   String   @db.VarChar(64)
  policyVersion String   @db.VarChar(32)
  topCategory   String?  @db.VarChar(40)
  topConfidence Float    @default(0)
  wouldAction   String   @db.VarChar(32)
  riskScore     Float    @default(0)
  agreedWithLive Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([policyVersion, createdAt])
  @@index([contentType, contentId])
  @@index([agreedWithLive, policyVersion])
}

/// Security / extreme-harm incident tracking for staff.
model ModerationIncident {
  id           String    @id @default(cuid())
  title        String    @db.VarChar(200)
  /// low | medium | high | critical
  severity     String    @db.VarChar(16)
  /// open | investigating | contained | closed
  status       String    @default("open") @db.VarChar(24)
  assigneeId   String?
  caseIds      Json?
  reportIds    Json?
  notes        String?   @db.Text
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  closeReason  String?   @db.VarChar(300)
  createdById  String?
  updatedAt    DateTime  @updatedAt

  @@index([status, severity, openedAt])
  @@index([assigneeId, status])
}

model ModerationRetentionPolicy {
  id            String   @id @default("default")
  caseDays      Int      @default(365)
  decisionDays  Int      @default(730)
  evidenceDays  Int      @default(180)
  shadowDays    Int      @default(90)
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

/// Immutable-style access log for sensitive case evidence (append-only via API).
model ModerationEvidenceAccessLog {
  id        String   @id @default(cuid())
  actorId   String
  caseId    String
  /// view | download
  action    String   @db.VarChar(16)
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

/// Active shadow policy version pointer (null = shadow off).
model ModerationRuntimeConfig {
  id                 String  @id @default("default")
  shadowPolicyVersionId String?
  shadowEnabled      Boolean @default(false)
  ahashThreshold     Int     @default(8)
  reportAbuseThreshold Int   @default(8)
  updatedAt          DateTime @updatedAt
  updatedById        String?
}
