NODE_ENV=production
PORT=3000
API_PREFIX=api
CLIENT_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change_me_with_long_secure_value
JWT_REFRESH_SECRET=change_me_with_long_secure_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

MEDIA_STORAGE_DRIVER=local
MEDIA_SIGNED_URL_TTL_SECONDS=900
MEDIA_LOCAL_BASE_PATH=./storage/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=secure-messaging-media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_ALLOW_PUBLIC_READS=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
VIDEO_STORAGE_PROVIDER=local
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_DOMAIN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

CACHE_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_WS_MAX_EVENTS=300
RATE_LIMIT_IP_BLOCK_SECONDS=900
FREE_MAX_UPLOAD_BYTES=5242880
FREE_MAX_OWNED_GROUPS=3
FREE_MAX_OWNED_CHANNELS=1
PREMIUM_MAX_UPLOAD_BYTES=104857600
PREMIUM_MAX_OWNED_GROUPS=200
PREMIUM_MAX_OWNED_CHANNELS=100
REWARDS_MAX_COINS_PER_DAY=250
MINIGAMES_MAX_PLAYS_PER_DAY=30
WALLET_INTERNAL_TOKEN=
WS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_URL=postgres://app:app@postgres:5432/secure_messaging
REDIS_URL=redis://redis:6379
