NODE_ENV=development
PORT=3000
API_PREFIX=api
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated browser origins (dev: include both localhost and 127.0.0.1). Never use * in production.
# Include Capacitor WebView origins for the Android app, plus any LAN Vite URL used from phones.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,http://192.168.0.144:5173
JWT_ACCESS_SECRET=replace_this_with_long_secret
JWT_REFRESH_SECRET=replace_this_with_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=tawasul
JWT_AUDIENCE=tawasul-api
JWT_ACCESS_KID=v1
JWT_REFRESH_KID=v1
# Rotation: keep previous kids while old tokens expire, e.g. v0:old_secret_at_least_16
JWT_ACCESS_PREVIOUS_KEYS=
JWT_REFRESH_PREVIOUS_KEYS=
# Required in production (min 16). Dev may fall back to JWT_ACCESS_SECRET with a warning.
OTP_PEPPER=replace_with_dedicated_otp_pepper
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
# local | s3 | r2  (local kept for development; use r2 in production)
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PROVIDER=
# Presigned upload/read TTL (600 = 10 minutes — good for R2 direct PUT)
MEDIA_SIGNED_URL_TTL_SECONDS=600
MEDIA_LOCAL_BASE_PATH=./storage/media
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=secure-messaging-media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_ALLOW_PUBLIC_READS=false
# Cloudflare R2 (required when MEDIA_STORAGE_DRIVER=r2) — leave empty locally
# Upload flow: client SHA-256 → /media/upload-ticket (instant if hash known) → PUT → /media/complete
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
# Optional Cloudflare Stream for video processing
VIDEO_STORAGE_PROVIDER=local
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_DOMAIN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CACHE_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_WS_MAX_EVENTS=300
RATE_LIMIT_IP_BLOCK_SECONDS=900
FREE_MAX_UPLOAD_BYTES=5242880
FREE_MAX_OWNED_GROUPS=3
FREE_MAX_OWNED_CHANNELS=1
PREMIUM_MAX_UPLOAD_BYTES=104857600
PREMIUM_MAX_OWNED_GROUPS=200
PREMIUM_MAX_OWNED_CHANNELS=100
REWARDS_MAX_COINS_PER_DAY=250
MINIGAMES_MAX_PLAYS_PER_DAY=30
WALLET_INTERNAL_TOKEN=
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_URL=postgres://app:app@localhost:5432/secure_messaging
REDIS_URL=redis://localhost:6379
# OTP — mock for local; live requires Twilio (never commit secrets)
OTP_MESSAGING_DRIVER=mock
OTP_ALLOW_MOCK_IN_PRODUCTION=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# WebRTC — STUN for local mesh; TURN required for cross-NAT (comma-separated URLs OK)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Firebase Cloud Messaging — leave empty until a service account exists.
# Easiest: save the JSON as backend/firebase-service-account.json (gitignored).
# Or set one of the options below. Private key newlines must be the two characters \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
OFFLINE_AI_MODE=true
